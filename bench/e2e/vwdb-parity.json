        "--signals",
        "tb_opb.regular64.word[0].data.q,tb_opb.scalar.word[0].data.q",
        "--at",
        "10ns",
        "--at",
        "20ns",
        "--json"
      ],
      "meta": {
        "waves": "/opt/ondas-fixtures/fst/fst0092-opb-s/waveform.fst"
      }
    },
