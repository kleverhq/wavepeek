{
  "tests": [
    {
      "name": "vwdb_parity_info_opb_s",
      "category": "info",
      "runs": 10,
      "warmup": 5,
      "command": [
        "{wavepeek_bin}",
        "info",
        "--waves",
        "/opt/ondas-fixtures/fst/fst0092-opb-s/waveform.fst",
        "--json"
      ],
      "meta": {
        "waves": "/opt/ondas-fixtures/fst/fst0092-opb-s/waveform.fst"
      }
    },
    {
      "name": "vwdb_parity_scope_opb_s",
      "category": "scope",
      "runs": 10,
      "warmup": 5,
      "command": [
        "{wavepeek_bin}",
        "scope",
        "--waves",
        "/opt/ondas-fixtures/fst/fst0092-opb-s/waveform.fst",
        "--filter",
        "^tb_opb[.](regular64|scalar)$",
        "--json"
      ],
      "meta": {
        "waves": "/opt/ondas-fixtures/fst/fst0092-opb-s/waveform.fst"
      }
    },
    {
      "name": "vwdb_parity_signal_opb_s",
      "category": "signal",
      "runs": 10,
      "warmup": 5,
      "command": [
        "{wavepeek_bin}",
