        "/opt/ondas-fixtures/fst/fst0092-opb-s/waveform.fst",
        "--signals",
        "tb_opb.regular64.word[0].data.q",
        "--from",
        "1ns",
        "--to",
        "5ns",
        "--on",
        "*",
        "--sample-mode",
        "native",
        "--json"
      ],
      "meta": {
        "waves": "/opt/ondas-fixtures/fst/fst0092-opb-s/waveform.fst"
