#!/usr/bin/env bash
set -euo pipefail

if [ "${1-}" = "--install-hooks" ]; then
    [ "$#" -eq 1 ] || {
        printf '%s\n' "usage: ./dev --install-hooks" >&2
        exit 2
    }
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
        printf '%s\n' "error: dev: current directory is not inside a Git worktree" >&2
        exit 1
    }
    git_dir="$(git rev-parse --path-format=absolute --absolute-git-dir)"
    hooks_dir="$git_dir/wavepeek-hooks"
    git config extensions.worktreeConfig true
    configured="$(git config --worktree --get core.hooksPath || true)"
    if [ -n "$configured" ] && [ "$configured" != "$hooks_dir" ]; then
        printf '%s\n' "error: dev: refusing to replace existing worktree core.hooksPath: $configured" >&2
        exit 1
    fi
    install -d -m 0755 "$hooks_dir"
    install -m 0755 "$root/dev" "$hooks_dir/dev"
    install -m 0755 "$root/tools/repo/git-hook" "$hooks_dir/pre-commit"
    install -m 0755 "$root/tools/repo/git-hook" "$hooks_dir/commit-msg"
    git config --worktree core.hooksPath "$hooks_dir"
    printf '%s\n' "Installed host Git hooks in $hooks_dir"
    exit 0
fi

exec_only=0
if [ "${1-}" = "--exec-only" ]; then
    exec_only=1
    shift
fi
if [ "$#" -eq 0 ]; then
    printf '%s\n' "usage: ./dev [--exec-only] COMMAND [ARG ...]" >&2
    exit 2
fi

root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    printf '%s\n' "error: dev: current directory is not inside a Git worktree" >&2
    exit 1
}
root="$(cd "$root" && pwd -P)"
if ! command -v docker >/dev/null; then
    printf '%s\n' "error: dev: Docker is unavailable; install it, then start this worktree explicitly with: ./dev true" >&2
    exit 1
fi
if ! command -v devcontainer >/dev/null; then
    printf '%s\n' "error: dev: Devcontainer CLI is unavailable; install it, then start this worktree explicitly with: ./dev true" >&2
    exit 1
fi
prefix="$(git rev-parse --show-prefix)"
workspace="/workspaces/$(basename "$root")"
container_dir="$workspace/${prefix%/}"
common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
common_dir="$(cd "$common_dir" && pwd -P)"

mount_args=()
expected_mounts=("$root"$'\t'"$workspace")
if [ "$common_dir" != "$root/.git" ]; then
    mount_args+=(--mount "type=bind,source=$common_dir,target=$common_dir")
    expected_mounts+=("$common_dir"$'\t'"$common_dir")
fi
if [ -n "${WAVEPEEK_FSDB_ABI-}${WAVEPEEK_FSDB_READER_LIBDIR-}${WAVEPEEK_FSDB_EMBED_RPATH-}" ]; then
    python3 -B "$root/tools/fsdb/check_fsdb_env.py" --require >/dev/null
fi
if [ -n "${VERDI_HOME-}" ]; then
    if [ ! -d "$VERDI_HOME" ]; then
        printf '%s\n' "error: dev: VERDI_HOME is not a directory: $VERDI_HOME" >&2
        exit 1
    fi
    verdi_home="$(cd "$VERDI_HOME" && pwd -P)"
    VERDI_HOME="$verdi_home" python3 -B "$root/tools/fsdb/check_fsdb_env.py" --require >/dev/null
    mount_args+=(--mount "type=bind,source=$verdi_home,target=/opt/verdi")
    expected_mounts+=("$verdi_home"$'\t'/opt/verdi)
fi

mapfile -t containers < <(docker ps -aq --filter "label=devcontainer.local_folder=$root")
if [ "${#containers[@]}" -gt 1 ]; then
    printf '%s\n' "error: dev: multiple containers exist for $root; remove the obsolete containers manually" >&2
    exit 1
fi
container_id="${containers[0]-}"

if [ -n "$container_id" ]; then
    mapfile -t actual_mounts < <(docker inspect --format '{{range .Mounts}}{{if eq .Type "bind"}}{{printf "%s\t%s\n" .Source .Destination}}{{end}}{{end}}' "$container_id" | grep -v '^$')
    if [ "$(printf '%s\n' "${expected_mounts[@]}" | sort)" != "$(printf '%s\n' "${actual_mounts[@]}" | sort)" ]; then
        printf '%s\n' "error: dev: existing container has stale worktree, Git common-directory, or Verdi mounts" >&2
        printf 'recreate with:' >&2
        printf ' %q' devcontainer up --workspace-folder "$root" "${mount_args[@]}" --remove-existing-container >&2
        printf '\n' >&2
        exit 1
    fi
fi

if [ "$exec_only" -eq 0 ]; then
    devcontainer up --workspace-folder "$root" "${mount_args[@]}"
    mapfile -t containers < <(docker ps -q --filter "label=devcontainer.local_folder=$root")
    if [ "${#containers[@]}" -ne 1 ]; then
        printf '%s\n' "error: dev: expected one running container for $root" >&2
        exit 1
    fi
    container_id="${containers[0]}"
elif [ -z "$container_id" ]; then
    printf '%s\n' "error: dev: no existing container for $root; start this worktree explicitly with: ./dev true" >&2
    exit 1
elif ! docker ps -q --filter "id=$container_id" | grep -q .; then
    printf '%s\n' "error: dev: container is stopped for $root; start this worktree explicitly with: ./dev true" >&2
    exit 1
fi

pidfile="/tmp/wavepeek-dev-$$-$RANDOM.pid"
statusfile="$pidfile.status"
token="$$-$RANDOM-$RANDOM"
forward_signal() {
    local signal="$1"
    while :; do
        if docker exec "$container_id" bash -c '
            read -r token pid start < "$1" || exit 1
            [ "$token" = "$2" ] || exit 1
            [ "$(awk "{print \$22}" "/proc/$pid/stat" 2>/dev/null)" = "$start" ] || exit 1
            kill -s "$3" -- "-$pid"
        ' bash "$pidfile" "$token" "$signal" >/dev/null 2>&1; then
            return
        fi
        if ! kill -0 "$exec_pid" 2>/dev/null && ! docker exec "$container_id" test -e "$pidfile" 2>/dev/null; then
            return
        fi
        sleep 0.01
    done
}
for signal in HUP INT QUIT TERM; do
    trap "forward_signal $signal" "$signal"
done

runner=(python3)
if [ ! -t 0 ]; then
    runner=(setsid --wait python3)
fi
devcontainer exec --container-id "$container_id" -- \
    "${runner[@]}" "$workspace/tools/repo/dev_exec.py" \
    "$token" "$pidfile" "$statusfile" "$container_dir" "$@" <&0 &
exec_pid=$!
set +e
while kill -0 "$exec_pid" 2>/dev/null; do
    wait "$exec_pid"
done
wait "$exec_pid"
status=$?
set -e
trap - HUP INT QUIT TERM
command_status="$(docker exec "$container_id" cat "$statusfile" 2>/dev/null || true)"
docker exec "$container_id" rm -f "$pidfile" "$statusfile" >/dev/null 2>&1 || true
if [[ "$command_status" =~ ^[0-9]+$ ]]; then
    status="$command_status"
fi
exit "$status"
