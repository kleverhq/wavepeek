    },
    {
      "name": "vwdb_parity_property_opb_s",
      "category": "property",
      "runs": 10,
      "warmup": 5,
      "command": [
        "{wavepeek_bin}",
        "property",
        "--waves",
        "/opt/ondas-fixtures/fst/fst0092-opb-s/waveform.fst",
        "--eval",
        "tb_opb.scalar.word[0].data.q == 1'b1",
        "--from",
        "1ns",
        "--to",
        "5ns",
        "--on",
        "tb_opb.scalar.word[0].data.q",
        "--sample-mode",
        "native",
        "--json"
      ],
      "meta": {
        "waves": "/opt/ondas-fixtures/fst/fst0092-opb-s/waveform.fst"
      }
    },
    {
      "name": "vwdb_parity_extract_opb_s",
      "category": "extract",
      "runs": 10,
      "warmup": 5,
      "command": [
        "{wavepeek_bin}",
        "extract",
        "generic",
        "--waves",
        "/opt/ondas-fixtures/fst/fst0092-opb-s/waveform.fst",
        "--on",
        "posedge tb_opb.scalar.word[0].data.q",
        "--when",
        "1",
        "--payload",
        "tb_opb.regular64.word[0].data.q",
        "--from",
        "1ns",
        "--to",
        "5ns",
        "--json"
